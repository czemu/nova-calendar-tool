{
    "name": "doxhunter/nova-calendar-tool",
    "description": "Calendar tool for Laravel Nova 5.x (In Development).",
    "keywords": [
        "laravel",
        "nova",
        "calendar"
    ],
    "license": "MIT",
    "authors": [
        {
            "name": "na",
            "email": "na",
            "homepage": "na"
        }
    ],
    "require": {
        "php": ">=7.1.0",
        "spatie/laravel-google-calendar": "^3.1.0"
    },
    "require-dev": {
        "laravel/nova": "^5.0"
    },
    "autoload": {
        "psr-4": {
            "Czemu\\NovaCalendarTool\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Czemu\\NovaCalendarTool\\ToolServiceProvider"
            ]
        }
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
